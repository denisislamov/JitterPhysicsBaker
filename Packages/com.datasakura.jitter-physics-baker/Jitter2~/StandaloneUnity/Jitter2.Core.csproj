<!--
  Builds the dormant Jitter2 snapshot into a netstandard2.1 assembly for Unity.

  Unity fixes game assemblies at C# 9 and cannot parse this snapshot, but that limit applies to
  sources it compiles - not to an assembly it merely loads. Compiling here, with a current
  compiler, sidesteps the language problem entirely and leaves only the framework gaps, which
  `Jitter2~/Compat` and `tools~/patch-jitter2-netstandard.py` close.

  The same output is consumed by the Unity client and the dedicated server. That is deliberate:
  one assembly cannot disagree with itself about which code path to take, and this package exists
  to guarantee both sides simulate the same world.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Jitter2.Core</AssemblyName>
    <RootNamespace>Jitter2</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)../=/</PathMap>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);CS1591;CS1734;CS1573;CS1712</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Runtime/**/*.cs" LinkBase="Runtime" />
    <Compile Include="../Compat/**/*.cs" LinkBase="Compat" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>

</Project>
